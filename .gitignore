# Dependencies
node_modules/

# Build output
dist/
dist.tmp/
release/
*.tgz

# Environment and secrets
.env
.env.local
.env.release
.env.signing
*.pid

# SQLite databases
*.db
*.db-wal
*.db-shm

# Sessions
.sessions.json

# macOS
.DS_Store

# Logs
logs/
*.log

# IDE
.vscode/
.idea/

# Playwright MCP artifacts
.playwright-mcp/

# Playwright E2E artefacts (regenerated each run)
playwright-report/
test-results/

# Bot status files (runtime state)
.bot-status.json
.slack-bot-status.json

# Local dev screenshots (Playwright/manual captures at repo root)
*.png

# App icon assets are source inputs for desktop packaging.
!build/
!build/icons/
!build/icons/*.png
!build/icons/*.icns

# Playwright visual baselines are committed (D3 audit evidence).
!tests/lexi/e2e/visual/**/*.png

# Python bytecode (browser-harness MCP wrapper)
__pycache__/
*.pyc
.superpowers/

# Worktree isolation directory (superpowers convention)
.worktrees/
